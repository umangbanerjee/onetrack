# OneTrack Environment Variables Example Template

# 1. Clerk Authentication (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# 2. Supabase Postgres Database (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# 3. Google Gemini AI API (https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy...

# 4. Arcjet Security (https://launch.arcjet.com)
ARCJET_KEY=ajkey_...

# 5. Config-Driven Admin Access (Comma-separated admin emails or Clerk IDs)
ADMIN_EMAILS=bumang124@mail.com
ADMIN_CLERK_USER_IDS=

# 6. Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
